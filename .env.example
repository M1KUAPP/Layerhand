DATABASE_URL=postgres://user:password@host:5432/layerhand
SESSION_SECRET=replace-with-a-long-random-value
FREE_DAILY_BUDGET_USD=175.50
S3_ENDPOINT=https://s3-compatible-storage.example.com
S3_REGION=auto
S3_BUCKET=layerhand-artifacts
S3_ACCESS_KEY_ID=replace-with-platform-secret
S3_SECRET_ACCESS_KEY=replace-with-platform-secret
BROWSERBASE_API_KEY=replace-with-platform-secret
OPENAI_API_KEY=replace-with-platform-secret
TRUST_PROXY_HOPS=0
# Optional. fake (the default), scripted, or agent. Agent mode also needs
# PUBLIC_URL, the address Browserbase's browser loads /photopea-host from.
RUN_MODE=fake
PUBLIC_URL=http://localhost:3000
